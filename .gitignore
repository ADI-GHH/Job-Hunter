# ============================================================
# JobHunter - Git Ignore Rules
# ============================================================

# --- Secrets & Environment ---
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
*.secret

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
*.egg-info/
dist/
build/
pip-wheel-metadata/
.venv/
venv/
env/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.eslintcache

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Claude / AI Tooling (Project-local only) ---
.claude/
.claude/settings.local.json
.claude/*.json
!CLAUDE.md

# --- Runtime Data & Logs (generated per-session) ---
data/
data/logs/
data/uploads/
data/output/
config/*/
!config/.gitkeep
!config/llm_models.yaml

# --- Docker ---
.docker/
docker-compose.override.yml

# --- OS / Misc ---
*.log
*.tmp
*.temp
*.bak
*.orig
*.pid
*.sock

# --- Test / Coverage artifacts ---
*.coverage
.coverage.*
coverage.xml
junit*.xml

# --- Large binary / generated assets ---
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
rejected_jobs.png

# --- Plan / Documentation artifacts (optional, keep if you want history) ---
*_SUMMARY.md
*_UPDATE.md
EVALUATOR_THROTTLE_UPDATE.md
IMPLEMENTATION_SUMMARY.md
PIPELINE_FIXES_SUMMARY.md
PLAN.md
CLAUDE.md
PROJECT_PLAN.md
Structure.txt

# --- PowerShell / Windows ---
setup.ps1