# ============================================================
# JobHunter - Environment Template
# Copy this file to .env and fill in real keys. NEVER commit secrets.
# ============================================================

# ------------------------------------------------------------
# LLM Provider Selection
# Options: openai | gemini | anthropic | groq | omniroute
# ------------------------------------------------------------
ACTIVE_LLM_PROVIDER=omniroute

# ------------------------------------------------------------
# Provider API Keys & Models
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ------------------------------------------------------------
# Groq (free tier, OpenAI-compatible)  -> ACTIVE_LLM_PROVIDER=groq
# ------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------
# OmniRoute (local gateway, OpenAI-compatible) -> ACTIVE_LLM_PROVIDER=omniroute
# ------------------------------------------------------------
# Key is optional for most local setups; leave the placeholder if unused.
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=jobhunter


# ------------------------------------------------------------
# OSINT / Outreach APIs (Phase 6)
# ------------------------------------------------------------
APOLLO_API_KEY=
HUNTER_API_KEY=

# ------------------------------------------------------------
# Evaluation Tuning
# ------------------------------------------------------------
# Minimum LLM alignment score (1-10) to advance to asset production
MIN_ALIGNMENT_SCORE=7

# ------------------------------------------------------------
# Server Config
# ------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=3000
LOG_LEVEL=info

# ------------------------------------------------------------
# Internal Container Paths (do not change unless refactoring)
# ------------------------------------------------------------
UPLOAD_DIR=/app/data/uploads
OUTPUT_DIR=/app/data/output
LOG_DIR=/app/data/logs
CONFIG_DIR=/app/config
CAREER_OPS_DIR=/app/career-ops
SCAN_HISTORY_PATH=/app/data/logs/scan-history.tsv
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright